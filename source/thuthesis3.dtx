% \begin{macro}{\@@_box_center:nn}
% 居中对齐的水平盒子。
%    \begin{macrocode}
\cs_new:Npn \@@_box_center:nn #1#2
  { \@@_box_to_wd:nn { #1 } { \tex_hss:D #2 \tex_hss:D } }
%    \end{macrocode}
