% \begin{macro}{\@@_box_ss:nn,\@@_box_ss:nv}
% 分散对齐的水平盒子，实现方法是在每个字符间插入 \tn{hss}。
% 在内容宽度不足时拉伸间距，在内容宽度超出时压缩间距。
%    \begin{macrocode}
\cs_new:Npn \@@_box_ss:nn #1#2
  {
    \group_begin:
      \@@_set_ccglue:N \c_@@_ss_skip
      \@@_box_to_wd:nn { #1 } { #2 }
    \group_end:
  }
\cs_generate_variant:Nn \@@_box_ss:nn { nv }
%    \end{macrocode}
% \end{macro}
