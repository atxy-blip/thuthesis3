% \begin{macro}{\@@_g_cover_en_supv:}
% 研究生英文封面的导师信息。这里用一个自然宽度的对齐盒子承载所有导师
% 行，由 \TeX{} 对齐算法决定标签和值的列宽；外层只负责把整个对象居中。
% 字母列表只表示三个继承字段的名字，不承载结构化内容，因此用
% |clist| 即可；真正的行数据存入序列，每个元素是一组 |{<label>}{<value>}|。
%    \begin{macrocode}
\cs_new_protected:Npn \@@_g_cover_en_supv:
  {
    \seq_clear:N \l_@@_tmpa_seq
    \clist_map_inline:nn { a, b, c }
      { \@@_g_cover_en_supv_item:Nn \l_@@_tmpa_seq {##1} }
    \@@_box_center:nn { \textwidth }
      { \@@_g_cover_en_supv_table:N \l_@@_tmpa_seq }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\@@_g_cover_en_supv_table:N}
% 先把各行展开为记号列表，再交给一个私有的 \tn{halign}。
% 这样保留 \TeX{} 对齐算法的自然列宽，
% 同时避免在 \tn{halign} 扫描正文时执行映射函数。
%    \begin{macrocode}
\cs_new_protected:Npn \@@_g_cover_en_supv_table:N #1
  {
    \tl_clear:N \l_@@_tmpa_tl
    \seq_map_inline:Nn #1
      { \tl_put_right:Nn \l_@@_tmpa_tl { \@@_g_cover_en_supv_row:nn ##1 } }
    \vbox:n
      {
        \tex_halign:D
          {
            \tex_hfil:D ## \@@_box_left:nn { 20.5 bp }
              { \skip_horizontal:n { 2 bp } \@@_name:n { colon _en } }
            & ## \tex_hfil:D \tex_cr:D
            \l_@@_tmpa_tl
          }
      }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\@@_g_cover_en_supv_row:nn}
% 只负责生成一行：第一列右对齐，其后接固定 |20.5bp| 的冒号盒子；
% 第二列左对齐。行首的 \tn{strut} 保留原 |tabular| 行的高度和深度。
%    \begin{macrocode}
\cs_new_protected:Npn \@@_g_cover_en_supv_row:nn #1#2
  { \strut #1 & #2 \tex_cr:D }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\@@_g_cover_en_supv_item:Nn}
% 构造导师信息项，只包含实际需要输出的导师行。
%    \begin{macrocode}
\cs_new_protected:Npn \@@_g_cover_en_supv_item:Nn #1#2
  {
    \@@_info_if_empty:nF { supv #2 _en }
      {
        \seq_put_right:Nn #1
          { { \@@_name:n { supv #2 _en } } { \@@_info:n { supv #2 _en } } }
      }
  }
%</def-g>
%    \end{macrocode}
% \end{macro}
