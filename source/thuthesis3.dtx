%
% 在草稿模式下，封面绘制将被禁用，有助于提升编译速度。
% 通过不同选项进行分流，使得钩子内部最终不包含逻辑判断，
% 仅需调用恰当的实例生成封面。
%    \begin{macrocode}
\bool_if:NF \g_@@_opt_draft_bool
  {
    \hook_gput_code:nnn { . / cover / body } { main }
      {
%<def-u>        \UseInstance { thu } { cover-u    }
%<*def-g>
        \UseInstance { thu } { cover-g-zh }
        \cleardoublepage
        \UseInstance { thu } { cover-g-en }
%</def-g>
%<*def-p>
        \UseInstance { thu } { cover-p-a  }
        \cleardoublepage
        \UseInstance { thu } { cover-p-b  }
%</def-p>
      }
%    \end{macrocode}
%
% 根据选项设置声明页钩子。
% 位于封面后的承诺书页面，
% 用于生成本科生的诚信承诺书或研究生的学位论文原创性声明。
%    \begin{macrocode}
    \hook_gput_code:nnn { . / cover / body } { decl-a }
      {
%<*(def-u|def-g)>
        \cleardoublepage
        \UseInstance { thu } { copyright }
        \cleardoublepage
%</(def-u|def-g)>
      }
%    \end{macrocode}
% 位于封底的声明页面。
%    \begin{macrocode}
    \hook_gput_code:nnn { . / cover / back } { decl-b }
      {
        \cleardoublepage
        \UseInstance { thu } { originality }
        \cleardoublepage
      }
  }
%</(def-u|def-g|def-p)>
%    \end{macrocode}
%
% 封面前处理。封面本身不占用页码编号。
%    \begin{macrocode}
%<*class>
\hook_gput_code:nnn { . / cover / begin } { presetup  }
  { \pagenumbering { gobble } }
%    \end{macrocode}
%
% 封面后处理。在标题页后清空标题中的换行符，
% 使用大写罗马字母页码，恢复正常字体设置。
%    \begin{macrocode}
\hook_gput_code:nnn { . / cover / end } { postsetup }
  {
    \tl_remove_all:Nn \g_@@_info_title_tl { \\ }
    \cleardoublepage
    \exp_args:NV \pagestyle \c_@@_fmt_pagestyle_tl
    \pagenumbering { Roman }
  }
%    \end{macrocode}
