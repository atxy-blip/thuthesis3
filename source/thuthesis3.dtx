% \begin{macro}{\@@_g_cover_info:}
% 研究生中文封面信息栏的入口。这里复现原 \cls{thuthesis}
% \cs{thu@titlepage@thesis} 中信息栏外层 \cs{parbox} 的固定尺寸：
% 学术学位使用 |[t][7.25cm][t]|，专业学位使用 |[t][5.25cm][b]|
% 并在下方保留 |62pt|。这些尺寸决定了页面下半部
% \cs{vfill} 后的信息栏与日期之间的相对位置，因此不能交给通用信息栏
% 自动计算。
%    \begin{macrocode}
\cs_new_protected:Npn \@@_g_cover_info:
  {
%<def-g-aca>    \@@_g_cover_info_box:nn { 7.25 cm } { t }
%<def-g-pro>    \@@_g_cover_info_box:nn { 5.25 cm } { b }
%<def-g-pro>    \skip_vertical:n { 62 pt }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\@@_g_cover_info_box:nn}
% 信息栏固定高度盒子。两个参数分别对应原 \cls{thuthesis}
% \cs{parbox} 的高度和内部垂直对齐方式；宽度始终为 \cs{textwidth}。
% 盒内正文由 \cs{@@_g_cover_info_body:NN} 生成，并显式传入行支柱
% 的高度、深度寄存器，保证各行共用同一组由当前字号行距计算出的度量。
%    \begin{macrocode}
\cs_new_protected:Npn \@@_g_cover_info_box:nn #1#2
  {
    \parbox [t] [#1] [#2] { \textwidth }
      { \@@_g_cover_info_body:NN \l_@@_tmpa_dim \l_@@_tmpb_dim }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\@@_g_cover_info_body:NN}
% 信息栏主体。原 \cls{thuthesis} 的
% \cs{thu@titlepage@info@tabular} 先插入 |2.3cm| 左缩进，
% 再进入单列 |tabular|；|tabular| 自身还会在左、右两侧产生
% |6pt| 的列间距。这里保留左侧 |2.3cm + 6pt|，
% 右侧 |6pt| 在每一行末尾补回。导师信息在本系列函数中直接从
% |g_@@_info_supv|\meta{letter}|_clist| 判断和取值，不依赖通用信息栏
% 的 \cs{@@_format_supv:} 预格式化副作用。
%    \begin{macrocode}
\cs_new_protected:Npn \@@_g_cover_info_body:NN #1#2
  {
    \@@_g_cover_info_dims:NN #1 #2
    \mode_leave_vertical:
    \skip_horizontal:n { 2.3 cm }
    \skip_horizontal:n { 6 pt }
    \@@_g_cover_info_table:NN #1 #2
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\@@_g_cover_info_dims:NN}
% 设置信息行支柱的高度和深度。原 \cls{thuthesis} 在信息栏中使用
% |\fangsong\fontsize{16bp}{31.2bp}\selectfont|，并在单列 |tabular|
% 中将 \cs{arraystretch} 设为 |1|。|array| 的行支柱按行距的
% |0.7| 和 |0.3| 分配高度、深度，因此这里用当前
% \cs{baselineskip} 计算出同一组行度量，并通过参数向下传递。
%    \begin{macrocode}
\cs_new_protected:Npn \@@_g_cover_info_dims:NN #1#2
  {
    \dim_set:Nn #1 { 7 \tex_baselineskip:D / 10 }
    \dim_set:Nn #2 { 3 \tex_baselineskip:D / 10 }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\@@_g_cover_info_table:NN}
% 将各个信息项组织成一个整体表格盒子。原 \cls{thuthesis} 用
% 单列 |tabular| 让所有非空 \cs{thu@info@item} 形成一个共同的对象；
% 这里通过通用盒子函数 \cs{@@_box_vcenter:n} 复现该对象的基线和行间
% 结构，避免在封面绘制代码中直接通过数学模式 \cs{vcenter} 取得同样
% 效果。项目顺序对应原 \cs{thu@titlepage@info}：
% 先排培养单位、学科/专业领域、作者、学号等普通信息，再排导师信息。
%    \begin{macrocode}
\cs_new_protected:Npn \@@_g_cover_info_table:NN #1#2
  {
    \@@_box_vcenter:n
      {
        \@@_g_cover_info_item:NN   #1 #2
        \@@_g_cover_author_item:NN #1 #2
        \@@_g_cover_supv_item:NN   #1 #2
      }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\@@_g_cover_info_item:NN,\@@_g_cover_info_item:NNn}
% 普通信息项的生成器。这里的条目使用 |g_@@_info_|\meta{item}|_tl|
% 存储，按原 \cls{thuthesis} \cs{thu@titlepage@info}
% 中导师之前的顺序输出。
%    \begin{macrocode}
\cs_new_protected:Npn \@@_g_cover_info_item:NN #1#2
  {
    \clist_map_inline:Nn \c_@@_name_coveritem_clist
      { \@@_g_cover_info_item:NNn #1 #2 {##1} }
  }
\cs_new_protected:Npn \@@_g_cover_info_item:NNn #1#2#3
  {
    \@@_info_if_empty:nF {#3}
      { \@@_g_cover_info_row:NNn #1 #2 {#3} }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\@@_g_cover_author_item:NN}
% 作者信息项的生成器。
% 由于不可能没有作者，这里只和其他函数保持命名一致。
%    \begin{macrocode}
\cs_new_protected:Npn \@@_g_cover_author_item:NN
  { \@@_g_cover_author_row:NN }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\@@_g_cover_supv_item:NN,\@@_g_cover_supv_item:NNn}
% 导师信息项的生成器。导师信息来自逗号列表
% |g_@@_info_supv|\meta{letter}|_clist|。标签名使用
% |supv a|、|supv b|、|supv c|，对应原 \cls{thuthesis} 的
% 指导教师、副指导教师、联合指导教师。
%    \begin{macrocode}
\cs_new_protected:Npn \@@_g_cover_supv_item:NN #1#2
  {
    \clist_map_inline:nn { a, b, c }
      { \@@_g_cover_supv_item:NNn #1 #2 {##1} }
  }
\cs_new_protected:Npn \@@_g_cover_supv_item:NNn #1#2#3
  {
    \@@_supv_if_empty:nF {#3}
      { \@@_g_cover_supv_row:NNn #1 #2 {#3} }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\@@_g_cover_info_strut:NN}
% 信息行的零宽支柱。它替代原 \cls{thuthesis} 单列 |tabular|
% 中由 |array| 机制插入的行支柱；两个参数分别是由
% \cs{@@_g_cover_info_dims:NN} 计算出的高度和深度。
%    \begin{macrocode}
\cs_new_protected:Npn \@@_g_cover_info_strut:NN #1#2
  { \rule [ - #2 ] { \c_zero_dim } { \dim_eval:n { #1 + #2 } } }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\@@_g_cover_info_row:NNnn}
% 排版一行信息。原 \cls{thuthesis}
% \cs{thu@titlepage@info@tabular} 的参数
% |{2.3cm}{2.85cm}{2.75cm}{0.77cm}| 分别给出左缩进、标签盒宽、
% 标签文字宽和冒号盒宽。本函数中的 |2.85cm|、|2.75cm| 和
% |.77cm| 即来自这些参数；标签文字使用分散对齐以对应原
% \cs{thu@fixed@box}，冒号使用中文冒号常量，值区由调用者给出。
%    \begin{macrocode}
\cs_new_protected:Npn \@@_g_cover_info_row:NNnn #1#2#3#4
  {
    \hbox:n
      {
        \@@_g_cover_info_strut:NN #1 #2
        \@@_box_left:nn { 2.85 cm }
          { \@@_box_ss:nn { 2.75 cm } { \@@_name:n {#3} } }
        \@@_box_left:nn { .77 cm } { \c_@@_name_colon_tl }
        #4
        \skip_horizontal:n { 6 pt }
      }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\@@_g_cover_info_row:NNn,
%   \@@_g_cover_author_row:NN,\@@_g_cover_supv_row:NNn}
% 普通信息行、作者信息行和导师信息行。
% 三者共享行几何，但值的处理方式不同。
%    \begin{macrocode}
\cs_new_protected:Npn \@@_g_cover_info_row:NNn #1#2#3
  {
    \@@_g_cover_info_row:NNnn #1 #2 {#3}
      { \@@_info:n {#3} }
  }
\cs_new_protected:Npn \@@_g_cover_author_row:NN #1#2
  {
    \@@_g_cover_info_row:NNnn #1 #2 { author }
      { \@@_g_cover_format_name:V \g_@@_info_author_tl }
  }
\cs_new_protected:Npn \@@_g_cover_supv_row:NNn #1#2#3
  {
    \@@_g_cover_info_row:NNnn #1 #2 { supv #3 }
      { \@@_g_cover_format_supv:n {#3} }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\@@_g_cover_format_supv:NNNn,\@@_g_cover_format_supv:n}
% 将导师信息拆解为姓名和职称。
%    \begin{macrocode}
\cs_new_protected:Npn \@@_g_cover_format_supv:NNNn #1#2#3#4
  {
    \clist_set_eq:Nc #1 { g_@@_info_supv #4 _clist }
    \clist_pop:NN #1 #2
    \clist_pop:NN #1 #3
    \@@_g_cover_format_name:V  #2
    \@@_g_cover_format_title:V #3
  }
