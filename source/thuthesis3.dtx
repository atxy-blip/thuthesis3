% \subsection{个人信息}
%
% \opt{info} 类用于录入封面、摘要和 PDF 元数据使用的个人信息。
% 推荐使用分组形式：
% \begin{verbatim}
% \thusetup[info]{
%   title  = {论文中文题目},
%   title* = {Thesis English Title},
% }
% \end{verbatim}
% 为了兼容旧版 \cls{thuthesis}，个人信息键也可以
% 不加 \opt{info/} 前缀，直接写作 |\thusetup{title = {...}}|。
% 新文档建议使用 \opt{info} 分组，旧文档不需要修改。
% 以下选项中带有星号的通常为对应英文字段。
%
% \begin{function}[added=2026-05-04]{info/title,info/title*}
%   \begin{syntax}
%     \OPT{info/title}  = \Arg{论文中文题目}
%     \OPT{info/title*} = \Arg{Thesis English Title}
%   \end{syntax}
% 中英文题目。中文题目可在内部使用 |\\| 手动断行。
% \end{function}
%
% \begin{function}[added=2026-05-04]{info/degree-category,info/degree-category*}
%   \begin{syntax}
%     \OPT{info/degree-category}  = \Arg{中文学科门类或专业学位类别}
%     \OPT{info/degree-category*} = \Arg{英文申请学位名称}
%   \end{syntax}
% 申请学位的学科门类或专业学位类别。学术型研究生中文填写所属学科门类，
% 例如哲学、经济学、法学、教育学、文学、历史学、理学、工学、农学、
% 医学、军事学、管理学或艺术学；英文博士填写 Doctor of Philosophy，
% 英文硕士按学科门类填写 Master of Arts 或 Master of Science。
% 专业型研究生填写专业学位类别，例如教育博士、工程硕士；
% 英文填写对应的专业学位名称，例如 Doctor of Education 或
% Master of Engineering。本科生不需要填写。
% \end{function}
%
% \begin{function}[added=2026-05-04]{info/department,info/department*}
%   \begin{syntax}
%     \OPT{info/department}  = \Arg{院系名称}
%     \OPT{info/department*} = \Arg{英文院系名称}
%   \end{syntax}
% 院系中英文名称。
% \end{function}
%
% \begin{function}[added=2026-05-04]{info/discipline,info/discipline*}
%   \begin{syntax}
%     \OPT{info/discipline}  = \Arg{学科名称}
%     \OPT{info/discipline*} = \Arg{英文学科名称}
%   \end{syntax}
% 学科名称。研究生学术型学位中，获得一级学科授权的学科填写一级学科名称，
% 其他填写二级学科名称；本科生填写专业名称，第二学位论文需标注“（第二学位）”。
% 专业型研究生学位通常使用 \opt{info/professional-field}。
% \end{function}
%
% \begin{function}[added=2026-05-04]{info/professional-field,info/professional-field*,info/engineering-field,info/engineering-field*}
%   \begin{syntax}
%     \OPT{info/professional-field}  = \Arg{专业领域}
%     \OPT{info/professional-field*} = \Arg{Professional Field}
%     \OPT{info/engineering-field}   = \Arg{工程领域}
%     \OPT{info/engineering-field*}  = \Arg{Engineering Field}
%   \end{syntax}
% 专业型研究生学位使用的专业领域。2019 级及之前工程硕士学位论文，
% 使用工程领域选项填写相应工程领域名称；其他专业学位类别的学位论文
% 无需填写工程领域。
% \end{function}
%
% \begin{function}[added=2026-05-04]{info/author,info/author*,info/student-id}
%   \begin{syntax}
%     \OPT{info/author}     = \Arg{中文姓名}
%     \OPT{info/author*}    = \Arg{Name in Pinyin}
%     \OPT{info/student-id} = \Arg{学号}
%   \end{syntax}
% 作者姓名和学号。学号仅用于本、研论文开题报告等需要显示学号的格式。
% \end{function}
%
% \begin{function}[added=2026-05-04]{info/supervisor,info/supervisor*}
%   \begin{syntax}
%     \OPT{info/supervisor}  = \Arg{导师姓名, 职称}
%     \OPT{info/supervisor*} = \Arg{Professor Supervisor Name}
%   \end{syntax}
% 导师信息。中文姓名与职称之间以西文逗号分隔，英文名无需添加逗号。
% \end{function}
%
% \begin{function}[added=2026-05-04]{info/associate-supervisor,info/associate-supervisor*}
%   \begin{syntax}
%     \OPT{info/associate-supervisor} = \Arg{副导师姓名, 职称}
%     \OPT{info/associate-supervisor*}= \Arg{Professor Assoc-Supervisor Name}
%   \end{syntax}
% 副导师信息。本科生对应辅导教师，硕士对应副指导教师。
% \end{function}
%
% \begin{function}[added=2026-05-04]{info/co-supervisor,info/co-supervisor*,info/joint-supervisor,info/joint-supervisor*}
%   \begin{syntax}
%     \OPT{info/co-supervisor}     = \Arg{联合指导教师姓名, 职称}
%     \OPT{info/co-supervisor*}    = \Arg{Professor Join-Supervisor Name}
%     \OPT{info/joint-supervisor}  = \Arg{联合指导教师姓名, 职称}
%     \OPT{info/joint-supervisor*} = \Arg{Professor Join-Supervisor Name}
%   \end{syntax}
% 联合指导教师信息。\opt{info/joint-supervisor} 是兼容别名。
% \end{function}
%
% \begin{function}[added=2026-05-04]{info/date,info/start-date,info/end-date}
%   \begin{syntax}
%     \OPT{info/date}       = \Arg{yyyy-mm-dd}
%     \OPT{info/start-date} = \Arg{yyyy-mm-dd}
%     \OPT{info/end-date}   = \Arg{yyyy-mm-dd}
%   \end{syntax}
% 成文日期，默认使用编译当天日期，也可以手动指定，要求使用 ISO 格式。
% \opt{info/start-date} 和 \opt{info/end-date} 用于博士后课题开始日期和结束日期。
% \end{function}
%
% \begin{function}[added=2026-05-04]{info/secret-level,info/secret-year}
%   \begin{syntax}
%     \OPT{info/secret-level} = \Arg{密级}
%     \OPT{info/secret-year}  = \Arg{保密年限}
%   \end{syntax}
% 秘密级别和年限。如果定义了 \opt{info/secret-level}，封面会显示对应密级。
% \end{function}
%
% \begin{function}[added=2026-05-04]{info/clc,info/udc,info/id,info/discipline-level-1,info/discipline-level-2}
%   \begin{syntax}
%     \OPT{info/clc}                = \Arg{中国图书资料分类法类号}
%     \OPT{info/udc}                = \Arg{国际十进制分类法类号}
%     \OPT{info/id}                 = \Arg{论文编号}
%     \OPT{info/discipline-level-1} = \Arg{一级学科名称}
%     \OPT{info/discipline-level-2} = \Arg{二级学科名称}
%   \end{syntax}
% 博士后封面相关信息。
% \end{function}
%
% \begin{function}[added=2026-05-04]{info/keywords,info/keywords*}
%   \begin{syntax}
%     \OPT{info/keywords}  = \Arg{关键词 1, 关键词 2}
%     \OPT{info/keywords*} = \Arg{keyword 1, keyword 2}
%   \end{syntax}
% 关键词列表。关键词之间以西文逗号隔开，模板会根据不同论文格式生成相应分隔符。
% \end{function}
%
% \begin{function}[added=2026-05-04]{info/spine-title,info/spine-author,info/spine-font,info/include-spine}
%   \begin{syntax}
%     \OPT{info/spine-title}  = \Arg{书脊标题}
%     \OPT{info/spine-author} = \Arg{书脊作者}
%     \OPT{info/spine-font}   = \Arg{字体命令}
%     \OPT{info/include-spine}= <true|(false)>
%   \end{syntax}
% 研究生论文书脊信息。默认书脊使用论文题目和作者姓名，也可以通过
% \opt{info/spine-title} 和 \opt{info/spine-author} 修改。
% \opt{info/include-spine} 用于选择是否在中文封面后生成书脊页。
% \end{function}
%
% \end{documentation}
