\NewDocumentEnvironment { notation } { O { 10 em } O { 5 em } }
  {
    \@@_chapter:V \c_@@_name_notation_tl
    \@@_make_notation:nn { #1 } { #2 }
  }
  { \endlist \cleardoublepage }
%    \end{macrocode}
% \end{environment}
