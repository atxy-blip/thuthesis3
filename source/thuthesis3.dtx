%<*(def-g|def-p)>
\cs_new:Npn \@@_zhdigits:nn #1#2
  {
%<def-g>    \zhnum_digits_null:n
      { \int_to_arabic:n { #1 } } \zhnum_output:n { #2 }
  }
%</(def-g|def-p)>
%    \end{macrocode}
% \end{macro}
