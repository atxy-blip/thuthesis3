% \begin{macro}{\@@_box_left:Nn}
% 左对齐的水平盒子。
%    \begin{macrocode}
\cs_new:Npn \@@_box_left:nn #1#2
  { \@@_box_to_wd:nn { #1 } { #2 \tex_hss:D } }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\@@_box_pad:nn}
% 内容不足指定宽度时在右侧补白，否则保持自然宽度。
%    \begin{macrocode}
\cs_new_protected:Npn \@@_box_pad:nn #1#2
  {
    \hbox_set:Nn \l_@@_tmpa_box {#2}
    \dim_compare:nNnTF { \box_wd:N \l_@@_tmpa_box } < {#1}
      { \@@_box_left:nn {#1} { \box_use:N \l_@@_tmpa_box } }
      { \box_use:N \l_@@_tmpa_box }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\@@_box_paragraph:nn}
% 替代 \tn{parbox} 的功能，生成指定宽度的顶对齐垂直盒子。
% \tn{@parboxrestore} 用于重置段落参数，保证 \tn{lastbox} 正确。
% 这里还需要通过全局变量存储 \tn{prevdepth} 的值，
% 保存盒子内部最后一行的真实深度，维持上下方的行距一致。
% \footnote{\url{https://tex.stackexchange.com/q/34971/}}
% \begin{arguments}
%   \item 宽度，|dim| 型变量
%   \item 内容
% \end{arguments}
%    \begin{macrocode}
\cs_new_protected:Npn \@@_box_paragraph:nn #1#2
  {
    \vbox_top:n
      {
        \@parboxrestore
        \dim_set:Nn \tex_hsize:D {#1}
        #2
        \dim_gset_eq:NN \g_@@_prevdepth_dim \tex_prevdepth:D
      }
    \tex_par:D
    \dim_set_eq:NN \tex_prevdepth:D \g_@@_prevdepth_dim
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\@@_box_paragraph_top:nn}
% 固定高度的顶对齐段落盒子，匹配 \tn{parbox}|[t][...]| 的行盒行为。
%    \begin{macrocode}
\cs_new_protected:Npn \@@_box_paragraph_top:nn
  {
    \skip_vertical:n { \f@size pt - \baselineskip }
    \@@_box_paragraph_top_to_ht:nn
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\@@_box_paragraph_top_to_ht:nn}
% 固定高度的顶对齐段落盒子，不补偿外部行距。
%    \begin{macrocode}
\cs_new_protected:Npn \@@_box_paragraph_top_to_ht:nn #1#2
  {
    \mode_leave_vertical:
    \vbox_top_to_ht:nn {#1}
      {
        \@parboxrestore
        \centering
        \dim_set:Nn \tex_hsize:D { \textwidth }
        #2 \tex_par:D
        \tex_vfill:D
      }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\@@_box_paragraph_ht:nn}
% 固定高度的顶对齐段落盒子。
% 底部修正来自 \LaTeXe{} 版日期 \tn{parbox} 后
% 可观察到的段落收尾行为。
% \begin{arguments}
%   \item 高度，|dim| 型变量
%   \item 内容
% \end{arguments}
%    \begin{macrocode}
\cs_new_protected:Npn \@@_box_paragraph_ht:nn #1#2
  {
    \@@_box_to_ht:nn {#1}
      {
        \@parboxrestore
        \centering
        \dim_set:Nn \tex_hsize:D { \textwidth }
        #2 \tex_par:D
      }
    \skip_vertical:n { -6 pt }
  }
%    \end{macrocode}
% \end{macro}
