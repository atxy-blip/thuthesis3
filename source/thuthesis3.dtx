% \tn{rightmargin} 得到的。
%    \begin{macrocode}
        \leftmargin .5\l_@@_tmpa_dim
        \rightmargin \leftmargin
        \advance \leftmargin #2
        \cs_set_eq:NN \makelabel \@@_notation_label:n
      }
  }
%    \end{macrocode}
% \end{macro}
