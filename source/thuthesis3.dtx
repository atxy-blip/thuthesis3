    hang             .choice:,
    hang / true        .code:n =
      {
        \cs_set:Npn \@@_fn_hang:
          {
            \int_set:Nn \tex_hangafter:D { 1 }
            \dim_set_eq:NN \tex_hangindent:D \c_@@_fnhang_dim
          }
      },
    hang / false       .code:n = { \@@_cs_clear:N \@@_fn_hang: },
    hang            .initial:n = true
