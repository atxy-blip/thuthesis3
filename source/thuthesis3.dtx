%    \begin{macrocode}
\cs_new:Npn \@@_box_st:nn #1#2
  { \@@_box_ss:nn { #1 } { #2 \skip_horizontal:N \c_@@_sh_skip } }
%    \end{macrocode}
% \end{macro}
