% \begin{macro}{\maketitle}
% \changes{v0.1.0}{2026/05/04}{使用 \LaTeX 钩子机制处理封面绘制。}
% 重定义 \tn{maketitle} 以生成封面。
% 在草稿模式下，封面绘制将被禁用，有助于提升编译速度。
% 在钩子机制下，这里只需要作为钩子的锚点，
% 具体需要执行的代码已被预先分发到钩子内。
% 为避免未调用 \tn{maketitle} 时生成封底，
% 封底钩子只在标题页生成时挂接到文档结束钩子，
% 并作为一次性钩子执行，避免重复调用 \tn{maketitle} 时重复生成。
% \cs{hook_use:n} 不能用 |.| 来简化钩子路径。
%    \begin{macrocode}
\RenewDocumentCommand \maketitle { }
  {
    \hook_use:n { thuthesis3 / cover / begin }
    \hook_use:n { thuthesis3 / cover / body  }
    \hook_use:n { thuthesis3 / cover / end   }
    \hook_gput_next_code:nn { end document }
      { \hook_use_once:n { thuthesis3 / cover / back } }
  }
%    \end{macrocode}
